# ─── Azure AD App Registration ───────────────────────────────
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here

# Redirect URI - update to your server's URL for production
# Local:  http://localhost:5100/auth/callback
# Server: https://your-server-ip-or-domain:5100/auth/callback
REDIRECT_URI=http://localhost:5100/auth/callback

# ─── Flask ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=generate-a-random-secret-key-here

# Set to true if using HTTPS
# SESSION_COOKIE_SECURE=false  # only for plain-http local dev; defaults to true when REDIRECT_URI is https://

# ─── Organization ───────────────────────────────────────────
ORG_DOMAIN=cloudfuze.com

# Time zone for every time shown in the app and MOMs (default IST = UTC+05:30)
DISPLAY_TZ_NAME=IST
DISPLAY_TZ_OFFSET_MINUTES=330

# Manually uploaded meeting videos: max size in MB (stored in UPLOAD_DIR, default ./uploads)
VIDEO_UPLOAD_MAX_MB=1024

# Teams meeting sync: first sync stores the last SYNC_INITIAL_DAYS days; after that every
# new meeting is kept permanently. Older history is never fetched unless backfill is on.
SYNC_INITIAL_DAYS=30
SYNC_BACKFILL_ENABLED=false
SYNC_BACKFILL_DAYS=365
# 0 = sync every org user who has ever signed in
SYNC_ACTIVE_USER_DAYS=0
SYNC_MEDIA_CHECKS_PER_RUN=60
MEETING_SYNC_ENABLED=true
MEETING_KEYWORDS=Customer Call,Migration Review,Client Meeting,Onboarding
ADMIN_EMAILS=bharath@cloudfuze.com

# Comma-separated migration manager emails (tracked separately on admin dashboard)
MANAGER_EMAILS=manager1@cloudfuze.com,manager2@cloudfuze.com

# Default CC recipients automatically pre-filled on every MOM send page (editable by sender)
# MOM_DEFAULT_DL_EMAIL = distribution list address (e.g. all-migrations@cloudfuze.com)
# MOM_DEFAULT_CC_EMAIL = individual always-copied address (e.g. manager@cloudfuze.com)
MOM_DEFAULT_DL_EMAIL=
MOM_DEFAULT_CC_EMAIL=phani.ryali@cloudfuze.com

# ─── PostgreSQL ─────────────────────────────────────────────
# These are used by docker-compose to create the database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=set-a-strong-password-here
POSTGRES_DB=meeting_moms

# Port for PostgreSQL on the host (default 5433 to avoid conflict with existing PostgreSQL)
DB_PORT=5433

# DATABASE_URL is auto-set by docker-compose; no need to change
# DATABASE_URL=postgresql+psycopg2://postgres:password@mom-db:5432/meeting_moms

# ─── Zoom (Server-to-Server OAuth) ──────────────────────────
# 1. Go to marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth
# 2. Enable scopes: meeting:read:admin, recording:read:admin,
#                   user:read:admin, report:read:admin
# 3. Copy Account ID, Client ID, and Client Secret below.
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# ─── OpenAI (for AI-powered MOM generation) ─────────────────
OPENAI_API_KEY=your-openai-api-key-here
# Model for the meeting Analyze button (cheap + good: gpt-4.1-mini; cheaper: gpt-4o-mini)
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
# Per-call limit; keep timeout x (retries + 1) under gunicorn's 120 s worker timeout
OPENAI_TIMEOUT_SECONDS=100
OPENAI_MAX_RETRIES=0

# ─── Daily audit email (optional; Graph application Mail.Send) ─
# Azure: grant Mail.Send (application permission) + admin consent.
# AUDIT_SENDER_MAILBOX must be a mailbox the app may send as (e.g. shared mailbox UPN).
# AUDIT_REPORT_RECIPIENTS = comma-separated To addresses.
# Run daily via cron: python scripts/send_audit_report.py
# AUDIT_REPORT_ENABLED=false skips cron only; Admin "Send audit report" still sends if mailbox/recipients are set.
AUDIT_REPORT_ENABLED=false
AUDIT_SENDER_MAILBOX=
AUDIT_REPORT_RECIPIENTS=
AUDIT_REPORT_DAYS=7

# --- Limits (optional; defaults shown) ---
# REQUEST_MAX_MB=25              # every route except the video upload
# VIDEO_UPLOAD_MAX_MB=1024       # one uploaded meeting video
# VIDEO_USER_QUOTA_MB=20480      # all uploaded videos of one user
# UPLOAD_MIN_FREE_MB=2048        # disk space always left on the upload volume
# DOCX_MAX_EXPANDED_MB=50        # uncompressed size of an uploaded .docx
# MOM_TRANSCRIPT_MAX_CHARS=300000
# Rate limits per user (per IP for sign-in): requests/seconds
# RATE_LIMIT_LOGIN=30/600  RATE_LIMIT_MOM_BUILDER=20/3600  RATE_LIMIT_ANALYZE=60/3600
# RATE_LIMIT_SEND_EMAIL=30/3600  RATE_LIMIT_UPLOAD_VIDEO=20/3600
# RATE_LIMIT_UPLOAD_TRANSCRIPT=60/3600  RATE_LIMIT_PARSE_FILE=60/3600
